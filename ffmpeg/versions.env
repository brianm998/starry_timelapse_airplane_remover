# Pinned inputs for the FFmpeg build (see ffmpeg/README.md).
#
# Everything that changes the produced binaries is pinned here or lives in build.sh and
# lib/*.sh.  CI keys its cache on a hash of this directory, so editing this file is how a
# new FFmpeg (or a new codec library) gets rebuilt and shipped.
#
# Tarballs are pinned by SHA-256.  Projects that publish no stable tarball (x264, SVT-AV1,
# libvpx) are pinned by git commit instead; a commit id is content-addressed, so it is as
# strong a pin as a checksum and survives the hosts re-generating their archives.
#
# Sourced by bash 3.2 (macOS /bin/bash) as well as newer bash: plain KEY=value only.

# ── FFmpeg ───────────────────────────────────────────────────────────────────
FFMPEG_VERSION=9.0.2
FFMPEG_URL=https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz
FFMPEG_SHA256=8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e

# ── software codecs, linked statically into ffmpeg and ffprobe ───────────────
# H.264 (GPL).  The `stable` branch of the VideoLAN repo, as of 2026-10-03.
X264_URL=https://code.videolan.org/videolan/x264.git
X264_COMMIT=b35605ace3ddf7c1a5d67a2eb553f034aef41d55

# HEVC (GPL).
X265_VERSION=4.2
X265_URL=https://bitbucket.org/multicoreware/x265_git/downloads/x265_4.2.tar.gz
X265_SHA256=40b1ea0453e0309f0eba934e0ddf533f8f6295966679e8894e8f1c1c8d5e1210

# AV1 decoder.  FFmpeg's own av1 decoder only works through a hardware accelerator, so
# without this a machine with no AV1 hardware cannot read an AV1 video at all.
DAV1D_VERSION=1.5.4
DAV1D_URL=https://downloads.videolan.org/pub/videolan/dav1d/1.5.4/dav1d-1.5.4.tar.xz
DAV1D_SHA256=686616b7c69eb88d44459391ab25cac13b6647a3b288835c5784e71c1514a5c5

# AV1 encoder (v4.2.0).
SVTAV1_VERSION=4.2.0
SVTAV1_URL=https://gitlab.com/AOMediaCodec/SVT-AV1.git
SVTAV1_COMMIT=9292ec8e32bce26f781f277ec8739b53426c4300

# VP8 / VP9 (v1.17.0, the commit the tag points at).
LIBVPX_VERSION=1.17.0
LIBVPX_URL=https://github.com/webmproject/libvpx.git
LIBVPX_COMMIT=6df3ec34557879fff673706f4a1d9fbd0f3a6f0e

# ── GPU encode and decode: header-only, loaded at run time ───────────────────
# None of these link a library.  FFmpeg opens the vendor's own (nvcuda / nvEncodeAPI, amfrt64,
# vulkan-1, ...) with dlopen / LoadLibrary when asked, so the same binary runs on a machine with
# the GPU and on one without; building it needs only the headers below.

# NVIDIA NVENC / NVDEC / CUVID.  The header version is the oldest NVIDIA driver the binary can
# use: n12.1.14 is 530.41.03 (Linux) / 531.61 (Windows), and it is also the oldest FFmpeg 9
# accepts.  Newer headers would only add features star does not use and cut off older drivers.
NVCODEC_VERSION=n12.1.14.1
NVCODEC_URL=https://github.com/FFmpeg/nv-codec-headers.git
NVCODEC_COMMIT=7c8e7fc751f803c672b42c37d9199c8a4f98b327

# AMD AMF (the Windows driver ships the runtime; on Linux it is AMD's proprietary stack).
# FFmpeg 9 needs 1.5.2 or newer.  Only amf/public/include is fetched.
AMF_VERSION=1.5.3
AMF_URL=https://github.com/GPUOpen-LibrariesAndSDKs/AMF.git
AMF_COMMIT=8c648005e07d4309033282bfd9947df2c7e76104

# Vulkan, for hardware decode and encode on any driver with Vulkan video support.  FFmpeg 9
# needs 1.3.277 or newer.
VULKAN_HEADERS_VERSION=1.4.363
VULKAN_HEADERS_URL=https://github.com/KhronosGroup/Vulkan-Headers.git
VULKAN_HEADERS_COMMIT=6802bb4733b63ed5efd3adb308a6c885ef180ea1

# ── macOS ────────────────────────────────────────────────────────────────────
# Oldest macOS the binaries are built to run on.  11.0 is the first release with Apple
# silicon, so it is the floor for the arm64 slice; the x64 slice uses the same.
MACOS_DEPLOYMENT_TARGET=11.0
