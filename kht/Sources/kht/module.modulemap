// Declaring kht.hpp as a textual header prevents Clang from treating it as a
// precompiled module. On Linux, SwiftPM auto-generates module maps for C/C++
// targets and disables implicit module compilation (-fno-implicit-modules).
// When kht_bridge does #include "kht.hpp", Clang would normally try to load
// the 'kht' precompiled module (.pcm), fail, and emit:
//   "module 'kht' is needed but has not been provided"
// With 'textual header', Clang does a plain text include instead.
module kht {
    textual header "include/kht.hpp"
    export *
}
